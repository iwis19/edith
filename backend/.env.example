# Copy to .env. .env is git-ignored; never commit it.

# Provider keys. CARD_PROVIDER picks which one writes the Look card (openai or gemini); without its key the backend
# answers with canned stub cards.
OPENAI_API_KEY=
GEMINI_API_KEY=
# CARD_PROVIDER=openai

# Tiger Cloud service connection string (postgres://...). Empty runs without a database.
DATABASE_URL=

# Shared with the headset build. Required when PUBLIC_SERVER=1 (set by the Dockerfile).
DEVICE_TOKEN=

# Model IDs. The defaults are in edith_backend/config.py.
# OPENAI_NAME_MODEL=gpt-4o
# OPENAI_FACT_MODEL=gpt-5.4-mini
# GEMINI_CARD_MODEL=gemini-3.5-flash-lite
# SCAN_MODEL=gemini-3.5-flash
# LIVE_MODEL=gemini-3.8-live
# EMBEDDING_MODEL=gemini-embedding-2

# Stub Card agent timing in ms after the request arrives. 0 for fast local runs.
# STUB_NAME_MS=300
# STUB_FACT_MS=700
# STUB_RARITY_MS=800
